# Database credentials via environment variables
DATABASE_URL=postgresql+psycopg2://user:password@hostname:port/dbname

# Optional separate DB url variables for compatibility
DB_URL_POSTGRES=
DB_URL_SMART_HEALTH=

# Databron voor de demo (CSV of SQLite)
DATA_SOURCE=csv
CSV_DATA_DIR=data

# Optionele Looker Studio embed-link
LOOKER_STUDIO_EMBED_URL=

# Authentication configuration
AUTH_CONFIG_FILE=/path/to/Code/auth_config.yaml
AUTH_COOKIE_KEY=replace-with-a-long-random-secret
AUTH_COOKIE_EXPIRY_DAYS=1
AUTH_SESSION_TIMEOUT_MINUTES=15
AUTH_TRUST_DAYS=14
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_PERIOD_MINUTES=10

# Logging
LOG_LEVEL=INFO
